{
	"name": "songmaker-frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@10.32.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/inject-worker-precache.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"generate:types": "cd .. && python scripts/generate_types.py",
		"check:types-sync": "cd .. && python scripts/generate_types.py --check"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource/open-sans": "^5.3.0",
		"@fontsource/oswald": "^5.3.0",
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@vitest/coverage-v8": "^5.0.2",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"jsdom": "^30.1.1",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.3.1",
		"vitest": "^5.0.2"
	},
	"pnpm": {
		"overrides": {
			"cookie": "1.1.1"
		}
	}
}
