{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true
	},
	// Restated from the generated config so the Playwright harness in e2e/ is
	// type-checked by `pnpm check` as well.
	"include": [
		".svelte-kit/types/**/$types.d.ts",
		"vite.config.ts",
		"playwright.config.ts",
		"src/**/*.js",
		"src/**/*.ts",
		"src/**/*.svelte",
		"e2e/**/*.ts"
	],
	"exclude": ["node_modules/**", "src/service-worker.ts"]
	// `#lib/*` is a Node subpath import declared in package.json `imports`.
}
