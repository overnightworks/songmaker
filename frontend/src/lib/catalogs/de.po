msgstr "Wie stark dein Stil-Prompt befolgt wird. Bei Turbo-Modellen ohne Wirkung."

msgctxt "paramField.shift"
msgid "Shift"
msgstr "Shift"

msgctxt "paramField.shiftHelp"
msgid "Biases denoising toward early structure or late detail. 3.0 is balanced."
msgstr ""
"Verschiebt das Entrauschen zu früher Struktur oder spätem Detail. 3.0 ist"
" ausgewogen."

msgctxt "paramField.cfgIntervalStart"
msgid "CFG Interval Start"
msgstr "CFG-Intervall Start"

msgctxt "paramField.cfgIntervalStartHelp"
msgid "Apply CFG starting from this point in the denoising trajectory (0.0–1.0)."
msgstr "CFG ab diesem Punkt der Entrauschungsbahn anwenden (0.0–1.0)."

msgctxt "paramField.cfgIntervalEnd"
msgid "CFG Interval End"
msgstr "CFG-Intervall Ende"

msgctxt "paramField.cfgIntervalEndHelp"
msgid "Stop applying CFG at this point in the denoising trajectory (0.0–1.0)."
msgstr "CFG ab diesem Punkt der Entrauschungsbahn nicht mehr anwenden (0.0–1.0)."

msgctxt "paramField.velocityNorm"
msgid "Velocity Norm"
msgstr "Velocity Norm"

msgctxt "paramField.velocityNormHelp"
msgid "DiT velocity normalization threshold. 0 = disabled."
msgstr "Schwellwert der Velocity-Normalisierung im DiT. 0 = aus."

msgctxt "paramField.velocityEma"
msgid "Velocity EMA"
msgstr "Velocity EMA"

msgctxt "paramField.velocityEmaHelp"
msgid "Exponential moving average smoothing for DiT velocity. 0 = disabled."
msgstr "Glättung der DiT-Velocity per exponentiellem gleitendem Mittel. 0 = aus."

msgctxt "paramField.latentShift"
msgid "Latent Shift"
msgstr "Latent Shift"

msgctxt "paramField.latentShiftHelp"
msgid "Shifts the latent space center. 0 = no shift."
msgstr "Verschiebt die Mitte des latenten Raums. 0 = keine Verschiebung."

msgctxt "paramField.latentRescale"
msgid "Latent Rescale"
msgstr "Latent Rescale"

msgctxt "paramField.latentRescaleHelp"
msgid "Rescales latent magnitude. 1.0 = no change."
msgstr "Skaliert die latente Größe neu. 1.0 = keine Änderung."

msgctxt "paramField.lmCodeStrength"
msgid "LM Code Strength"
msgstr "LM-Code-Stärke"

msgctxt "paramField.lmCodeStrengthHelp"
msgid ""
"How much the LM codes guide the DiT. 1.0 = full guidance, 0 = codes "
"ignored."
msgstr ""
"Wie stark die LM-Codes den DiT führen. 1.0 = volle Führung, 0 = Codes "
"ignoriert."

msgctxt "paramField.inferMethod"
msgid "Infer Method"
msgstr "Inferenzmethode"

msgctxt "paramField.inferMethodHelp"
msgid ""
"ODE = deterministic, reproducible. SDE = adds randomness, sometimes more "
"natural."
msgstr ""
"ODE = deterministisch, reproduzierbar. SDE = bringt Zufall hinein, klingt"
" manchmal natürlicher."

msgctxt "paramField.sampler"
msgid "Sampler"
msgstr "Sampler"

msgctxt "paramField.samplerHelp"
msgid "Diffusion sampler algorithm. heun is a second-order predictor-corrector."
msgstr ""
"Sampler-Algorithmus der Diffusion. heun ist ein Prädiktor-Korrektor "
"zweiter Ordnung."

msgctxt "paramField.adaptiveDualGuidance"
msgid "Adaptive Dual Guidance"
msgstr "Adaptive Dual Guidance"

msgctxt "paramField.adaptiveDualGuidanceHelp"
msgid ""
"Smarter CFG that prevents over-saturation. Only matters when "
"guidance_scale > 1."
msgstr ""
"Klügeres CFG, das Übersättigung verhindert. Wirkt nur bei guidance_scale "
"> 1."

msgctxt "paramField.temperature"
msgid "Temperature"
msgstr "Temperatur"

msgctxt "paramField.temperatureHelp"
msgid ""
"How creative the LM is when planning. Higher = more varied, lower = more "
"predictable."
msgstr ""
"Wie kreativ das LM beim Planen ist. Höher = abwechslungsreicher, "
"niedriger = vorhersehbarer."

msgctxt "paramField.topK"
msgid "Top-K"
msgstr "Top-K"

msgctxt "paramField.topKHelp"
msgid "Limit LM sampling to the K most-likely tokens. 0 = disabled."
msgstr ""
"Beschränkt das Sampling des LM auf die K wahrscheinlichsten Tokens. 0 = "
"aus."

msgctxt "paramField.topP"
msgid "Top-P"
msgstr "Top-P"

msgctxt "paramField.topPHelp"
msgid ""
"Nucleus sampling — sample only from tokens covering P of the probability "
"mass."
msgstr ""
"Nucleus-Sampling – nur aus den Tokens samplen, die den Anteil P der "
"Wahrscheinlichkeitsmasse abdecken."

msgctxt "paramField.cfgScale"
msgid "CFG Scale"
msgstr "CFG Scale"

msgctxt "paramField.cfgScaleHelp"
msgid "CFG strength for the LM's plan (separate from the DiT guidance_scale)."
msgstr "CFG-Stärke für den Plan des LM (getrennt von guidance_scale des DiT)."

msgctxt "paramField.repetitionPenalty"
msgid "Rep. Penalty"
msgstr "Wiederh.-Strafe"

msgctxt "paramField.repetitionPenaltyHelp"
msgid "Discourages the LM from repeating itself. 1.0 = off."
msgstr "Hält das LM davon ab, sich zu wiederholen. 1.0 = aus."

msgctxt "paramField.batchSize"
msgid "Batch Size"
msgstr "Batch-Größe"

msgctxt "paramField.batchSizeHelp"
msgid "Number of audio variations to generate from one request (1–8)."
msgstr "Anzahl der Audio-Varianten, die aus einer Anfrage generiert werden (1–8)."

msgctxt "paramField.thinking"
msgid "Thinking"
msgstr "Thinking"

msgctxt "paramField.thinkingHelp"
msgid "Let the LM plan musical structure before audio generation."
msgstr "Lässt das LM vor der Audiogenerierung die musikalische Struktur planen."

msgctxt "paramField.cotCaption"
msgid "CoT Caption"
msgstr "CoT-Caption"

msgctxt "paramField.cotCaptionHelp"
msgid "Let the LM rewrite your style caption to be more model-friendly."
msgstr ""
"Lässt das LM deine Stil-Caption so umschreiben, dass das Modell sie "
"besser versteht."

msgctxt "paramField.cotLanguage"
msgid "CoT Language"
msgstr "CoT-Sprache"

msgctxt "paramField.cotLanguageHelp"
msgid "Let the LM auto-detect the language of your lyrics."
msgstr "Lässt das LM die Sprache deines Songtexts selbst erkennen."

msgctxt "paramField.negativePrompt"
msgid "Negative Prompt"
msgstr "Negativ-Prompt"

msgctxt "paramField.negativePromptHelp"
msgid "Tell the LM what NOT to include in its musical plan."
msgstr "Sag dem LM, was NICHT in seinen musikalischen Plan soll."

msgctxt "paramField.negativePromptPlaceholder"
msgid "e.g. bad quality, noise"
msgstr "z. B. schlechte Qualität, Rauschen"

msgctxt "paramField.sectionDit"
msgid "DiT (Sound)"
msgstr "DiT (Klang)"

msgctxt "paramField.sectionLm"
msgid "LM (Lyrics)"
msgstr "LM (Songtext)"

