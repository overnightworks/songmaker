# Songmaker .env example — copy to .env and fill in values.
#
# This is the ONLY env file. The app reads it via Pydantic Settings; Docker
# Compose reads it for variable substitution into the container environment
# blocks (e.g. DATABASE_URL is constructed below from POSTGRES_USER/DB; the
# password comes from its secret file).
#
# IMPORTANT: Settings uses extra="forbid" — a typo'd env var name (e.g.
# REQUSET_TIMEOUT) will fail Settings construction at startup with a clear
# ValidationError instead of silently using the default. This is intentional.
#
# To generate a secret: python3 -c "import secrets; print(secrets.token_hex(32))"

# ─────────────────────────────────────────────────────────────────────────
# REQUIRED SECRETS are not here. The session secret, the database password, the
# internal token and the monitoring token are four files in ~/.secrets/songmaker
# (SONGMAKER_SECRETS_DIR moves it): session-secret, postgres-password,
# internal-token and monitoring-token, each holding one generated value (`hal setup`
# creates a missing file and keeps an existing one; hf-token is created empty by
# hand). Compose mounts each into the services that read it; see
# docs/security.md ("Secrets").
# ─────────────────────────────────────────────────────────────────────────

POSTGRES_USER=songmaker
POSTGRES_DB=songmaker

# Sign-in through Keycloak. The client secret is not here: Compose mounts the
# edge-owned file ~/.secrets/keycloak/clients/songmaker into the web container.
# Accounts come from Keycloak; there is no admin bootstrap.
OIDC_ISSUER=https://CHANGEME_keycloak_host/realms/CHANGEME_realm
# OIDC_CLIENT_ID=songmaker                    # Compose default

# Grafana monitoring (http://localhost:3000). GRAFANA_PASSWORD is required:
# without it `docker compose up`, `down`, and `logs` refuse, naming it, instead
# of Grafana starting with admin/admin. It only seeds Grafana's first start; to
# change it later, see docs/security.md ("Secrets").
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGEME_grafana_password

# Alert channel (issue #333) — the one email every alert source ends up at:
# scripts/alert.sh (called from systemd OnFailure= units) and Alertmanager
# (fed by monitoring/rules/alert.rules.yml) both read these same five values.
# Neither pretends to have sent anything if one is missing: the stack's
# alertmanager refuses to start and auto-deploy.sh refuses to deploy, both
# naming the missing key, rather than running with a mute alarm. Gmail: create
# an App password at https://myaccount.google.com/apppasswords (requires
# 2FA) — your normal Gmail password will not work here. Single-quote any
# value containing a space or a shell character ('p&ss w0rd'): that is the
# one quoting both readers of this file agree on.
ALERT_EMAIL_TO=CHANGEME_your_address@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGEME_your_address@example.com
SMTP_PASSWORD=CHANGEME_gmail_app_password

# ─────────────────────────────────────────────────────────────────────────
# Set automatically by docker-compose — do NOT add to .env unless you know
# what you're doing. docker-compose.yml uses the POSTGRES_* values above
# (and a hardcoded redis hostname) to build these URLs and pass them into
# the container's environment block. The app reads them from there.
# ─────────────────────────────────────────────────────────────────────────
#
# DATABASE_URL=postgresql://${POSTGRES_USER}@postgres:5432/${POSTGRES_DB}
# REDIS_URL=redis://redis:6379/0

# ─────────────────────────────────────────────────────────────────────────
# OPTIONAL — overrides of Settings fields that Compose passes into the
# containers. The defaults shown here match src/songmaker_cli/settings.py.
# Uncomment a line only if you actually want to change the default.
# ─────────────────────────────────────────────────────────────────────────

# ── Access control ──────────────────────────────────────────────────────
# ALLOWED_HOSTS=yourdomain.com,localhost      # Host and Origin allowlist, exact host names, no wildcards; Compose always appends localhost,127.0.0.1,songmaker-web
# CORS_ORIGIN=https://yourdomain.com          # default: None (no CORS)
# TOKEN_CLIENTS=hal                           # default: "" (no token admitted)
#   Comma list of the `azp` values of the OAuth clients whose access tokens act as
#   their person on /api/ and /audio/; an empty entry in a non-empty list fails startup.
# TRUSTED_PROXIES=172.16.0.0/12               # default: "" (no proxies)
#   IPs and/or CIDR networks; an unparsable entry fails startup.
PUBLIC_BASE_URL=https://yourdomain.com          # required: the web app refuses to start without it
#   The address share links (album/song/generation/playlist) are built
#   from — not derived from the request, since TLS terminates at the proxy
#   and the request never carries a trustworthy scheme (see docs/security.md
#   "Proxy trust", issue #339). The Keycloak sign-in builds its redirect and
#   post-logout addresses from it too, so the web app does not start without
#   it. A wrong value (mismatched scheme or domain) hands out a link that
#   looks legitimate but 404s or trips a mixed-content/CORS error for
#   whoever opens it.

# ── Job rate limits (per hour, overrideable per-user in settings UI) ────
# GENERATION_RATE_LIMIT_USER=30

# ── arq workers ─────────────────────────────────────────────────────────
# ARQ_JOB_TIMEOUT=1000                        # max seconds per generate job (~17 min — long enough for cold xl-turbo load)
# MAX_USER_LORAS=10                            # non-deleted voices per musician
# MAX_QUEUED_LORA_TRAINING_JOBS=2              # global waiting LoRA trainings
# LORA_TRAINING_JOB_TIMEOUT=3600              # own max seconds per LoRA training job
# LORA_TRAINING_EPOCHS=500
# LORA_TRAINING_BATCH_SIZE=1
# LORA_TRAINING_GRADIENT_ACCUMULATION=4
# LORA_TRAINING_SAVE_EVERY_N_EPOCHS=5
# LORA_TRAINING_POLL_INTERVAL_SECONDS=5
# MUSIC_MAX_JOBS=2                            # concurrent jobs in music-worker
# SCORING_MAX_JOBS=1                          # concurrent jobs in scoring-worker
# SCORING_DEVICE=cpu                          # "cpu" or "cuda"
# SCORER_TIMEOUT_SECONDS=120                  # budget per scorer
# TEXT_ACCURACY_TIMEOUT_SECONDS=300           # own budget — a cold Whisper model load counts against it
#
# The scorer subprocess watchdog is derived from these: the slowest scorer
# budget + one more scorer budget (deferred scorers run afterwards) + headroom.
# With the defaults that is 540s. Keep it under ARQ_JOB_TIMEOUT (1000s), or arq
# kills the job before the watchdog can end the run cleanly.

# ── Final deletion ──────────────────────────────────────────────────────
# FINAL_DELETION_DAYS=30                      # days until the trash is purged and archived takes are deleted

# ── Claude integration ──────────────────────────────────────────────────
# No co-writer turn or cover runs on a Claude CLI; the mounts are read-only,
# see docs/security.md, "Agent-CLI Mounts".

# ── Agent-CLI mirror location ───────────────────────────────────────────
# Host directory holding the redacted credential mirrors mounted by Compose.
# The environment wins over this key, then the default below applies. Re-run
# the mirror and autostart installers after changing it.
# SONGMAKER_CLI_CREDENTIALS_DIR=~/.songmaker/agent-cli-credentials
# SONGMAKER_CLAUDE_CLI=~/.local/bin/claude
# SONGMAKER_GROK_CLI=~/.grok/bin/grok
# These CLI-path overrides take effect only when exported in the
# deployment environment, not when written only in `.env`: the preflight reads
# its values from the exported environment and does not load `.env`. Compose
# mounts the agent CLI executables and their redacted credential mirrors
# into songmaker-web.

# ── ACE-Step worker pool ────────────────────────────────────────────────
#
# The ACE-Step subprocess runs inside the songmaker-acestep-worker-0
# container. WORKER_ID/HOST/PORT/GPU_ID are set in docker-compose.yml
# and typically don't need overrides. See docs/acestep.md for the
# worker pool architecture.
#
# ACESTEP_WORKER_VRAM_GB=24                   # VRAM budget per worker
# ACESTEP_WORKER_CONTROL_PLANE_URL=http://songmaker-web:8080
# ACESTEP_STARTUP_TIMEOUT_SECONDS=540         # subprocess health-check window (eager cold xl-turbo + vLLM load ~5–8 min)
# HF_TOKEN=hf_...                             # Hugging Face token for model downloads
# ACESTEP_LM_MODEL_PATH=acestep-5Hz-lm-1.7B   # default is 4B (operator decision, #202: proven on this card);
#                                              # lower to 1.7B on a tighter card — ACE-Step's own tier6b
#                                              # recommendation for 20-24GB cards — see docs/acestep.md
# ACESTEP_SKIP_VRAM_PREFLIGHT=1               # default is off (#202): the LM now leaves the DiT's
#                                              # duration-aware demand free, so the preflight passes long
#                                              # xl-turbo takes. Emergency bypass only — setting it to 1
#                                              # turns a clean refusal into an OOM mid-generation
# ACESTEP_LM_DIT_RESERVE_DURATION_S=180        # longest track the LM keeps DiT room for; default is the
#                                              # GPU tier's max_duration_with_lm (480s on a 24GB card).
#                                              # Lower it to hand the LM a larger KV cache — see docs/acestep.md
# ACESTEP_LM_DIT_RESERVE_BATCH=2               # samples per request the DiT room is sized for (default 1).
#                                              # Raise it only if you generate batches — see docs/acestep.md
