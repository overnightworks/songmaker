# The application may build on the independent packages; none of them may
# depend on the application. quality's `import-contract` rule runs these
# contracts over the in-tree import
# graph, so a chain through another in-tree module is caught as well as a
# direct import. include_external_packages records an import of an installed
# package (webauth) as one opaque node and never scans that
# package's own imports, so a chain reaching the application through one of
# them is not caught here.
#
# independent-packages: the engine packages never depend on the application.
# persistence-below-http-contract: songmaker_cli.db never imports
#   songmaker_cli.api_models, directly or through another in-tree module.
# persistence-below-http-framework: songmaker_cli.db never imports fastapi or
#   starlette.
# application-layers: songmaker_cli modules import only downward (entry points,
#   workers, routes, runners, the gateway turn, co-writer and MCP, services,
#   HTTP contract, scoring and health types, persistence, below persistence,
#   settings, job timing, constants, leaves), and the routes never import each other.
#   exhaustive: a module without a row breaks the contract. The one ignored import is
#   settings reading the `agent` section's model from `agent.settings`, a leaf that
#   imports no in-tree module (it holds the section the settings embed, as
#   the agents library's `AgentConfig` does for every app).
# scoring-is-self-contained: the scorers reach neither persistence nor the HTTP
#   framework.
# agents-importers: the installed agents library is one opaque node, so
#   this contract lists the modules that import it at all and a new importer shows as a
#   diff here. Which of its submodules each may import is reviewed: only agent/backend.py
#   and agent/mcp.py import its run and MCP machinery, agent/settings.py alone its
#   `config`, and the route and tool modules only its `tools`,
#   except conversation_api.py, which also imports its `turn`.
[importlinter]
include_external_packages = True
root_packages =
    acestep_engine
    acestep_worker
    audio_engine
    songmaker_cli

[importlinter:contract:independent-packages]
name = Independent packages do not import the application
type = forbidden
source_modules =
    acestep_engine
    acestep_worker
    audio_engine
forbidden_modules =
    songmaker_cli

[importlinter:contract:persistence-below-http-contract]
name = Persistence does not import the HTTP contract
type = forbidden
source_modules =
    songmaker_cli.db
forbidden_modules =
    songmaker_cli.api_models

[importlinter:contract:persistence-below-http-framework]
name = Persistence does not import the HTTP framework
type = forbidden
source_modules =
    songmaker_cli.db
forbidden_modules =
    fastapi
    starlette

[importlinter:contract:application-layers]
name = The application's layers point downward and routes stay apart
type = layers
containers =
    songmaker_cli
exhaustive = true
layers =
    main | (arq_worker)
    server | music_worker | scoring_worker
    api | worker_base
    (admin_api) | (album_api) | (audio_api) | (auth_api) | (conversation_api) | (generation_api) | (health_api) | (internal_api) | (jobs_api) | (library_api) | (lora_api) | (memory_api) | (playlist_api) | (reference_api) | (resource_event_api) | (settings_api) | (shared_views_api) | (sharing_api) | (song_api) | (take_judging_api)
    lifecycle
    (cover_runner)
    jobs
    agent
    cowriter
    mcp_server
    (api_helpers) : (auth_dependencies) : (auth_stores) : (cleanup) : (config) : (cover_suggestions) : (oidc_client) : (queue_streams) : (reference_audio) : (refusals) : (scheduler) : (app_context) : (arq_pool) : (covers) : (generate) : (logging_config) : (middleware) : (redis_client) : (request_policies) : (library_cursor) : (shared_access)
    api_models
    (health_types) | (scoring)
    db
    (parser) | (worker_liveness)
    settings
    job_timing
    constants
    (acestep_capabilities) | (acestep_state) | (arq_codec) | (audio_files) | (audio_paths) | (cover_job_errors) | (env_override) | (errors) | (generation_params) | (invariants) | (job_types) | (theme_types) | (timestamps) | (whisper_cues) | (words)
ignore_imports =
    songmaker_cli.settings -> songmaker_cli.agent.settings

[importlinter:contract:scoring-is-self-contained]
name = Scorers reach neither persistence nor HTTP
type = forbidden
source_modules =
    songmaker_cli.scoring
forbidden_modules =
    songmaker_cli.db
    sqlalchemy
    fastapi
    starlette

[importlinter:contract:agents-importers]
name = Only the agent, tool and route modules import the agents library
type = forbidden
source_modules =
    songmaker_cli
forbidden_modules =
    agents
allow_indirect_imports = True
ignore_imports =
    songmaker_cli.agent.backend -> agents
    songmaker_cli.agent.mcp -> agents
    songmaker_cli.agent.settings -> agents
    songmaker_cli.agent.tools -> agents
    songmaker_cli.cowriter.tools -> agents
    songmaker_cli.conversation_api -> agents
