# The application may build on the independent packages; none of them may
# depend on the application. CI runs `lint-imports` over the in-tree import
# graph, so a chain through another in-tree package is caught as well as a
# direct import. include_external_packages records an import of an installed
# package (agent_providers, webauth) as one opaque node and never scans that
# package's own imports, so a chain reaching the application through one of
# them is not caught here. The persistence-below-http-contract contract keeps
# songmaker_cli.db from importing songmaker_cli.api_models, directly or through
# another in-tree module. The persistence-below-http-framework contract keeps
# songmaker_cli.db from importing fastapi or starlette.
[importlinter]
include_external_packages = True
root_packages =
    acestep_engine
    acestep_worker
    audio_engine
    songmaker_cli

[importlinter:contract:independent-packages]
name = Independent packages do not import the application
type = forbidden
source_modules =
    acestep_engine
    acestep_worker
    audio_engine
forbidden_modules =
    songmaker_cli

[importlinter:contract:persistence-below-http-contract]
name = Persistence does not import the HTTP contract
type = forbidden
source_modules =
    songmaker_cli.db
forbidden_modules =
    songmaker_cli.api_models

[importlinter:contract:persistence-below-http-framework]
name = Persistence does not import the HTTP framework
type = forbidden
source_modules =
    songmaker_cli.db
forbidden_modules =
    fastapi
    starlette
