# The application may build on the independent packages; none of them may
# depend on the application. CI runs `lint-imports` over the real import
# graph, so an indirect chain is caught as well as a direct import.
[importlinter]
include_external_packages = True
root_packages =
    acestep_engine
    acestep_worker
    agent_providers
    audio_engine
    songmaker_cli
    webauth

[importlinter:contract:independent-packages]
name = Independent packages do not import the application
type = forbidden
source_modules =
    acestep_engine
    acestep_worker
    agent_providers
    audio_engine
    webauth
forbidden_modules =
    songmaker_cli

[importlinter:contract:webauth-does-not-import-agent-providers]
name = webauth does not import agent_providers
type = forbidden
source_modules =
    webauth
forbidden_modules =
    agent_providers

[importlinter:contract:agent-providers-does-not-import-webauth]
name = agent_providers does not import webauth
type = forbidden
source_modules =
    agent_providers
forbidden_modules =
    webauth

[importlinter:contract:webauth-does-not-import-sqlalchemy]
name = webauth persists nothing itself
type = forbidden
source_modules =
    webauth
forbidden_modules =
    sqlalchemy
