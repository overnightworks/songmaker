# Patterns match repository-relative path:export; every exception needs an owner/reason.
*:*ForTests # Deliberate reset/control seams for isolated tests.
frontend/src/routes/*:ssr # SvelteKit route configuration.
frontend/src/routes/*:prerender # SvelteKit route configuration.
frontend/src/lib/stores/resourceSync.ts:ResourceSyncController # Dependency-injected sync controller: isolated race, reconnect, authorization and bounded-buffer tests without the singleton browser/network owner.
