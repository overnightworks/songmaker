[Unit]
Description=Songmaker alert dispatch for %i (issue #333)

[Service]
Type=oneshot
# WorkingDirectory, ExecStart, and User below are placeholders (this
# repo's canonical checkout/owner), kept concrete only so
# `systemd-analyze verify` can check absolute paths.
# scripts/install_autodeploy.sh and scripts/install-autostart.sh both
# install this template unit alongside their own, overwriting all three
# with the real project root and invoking user at install time — copying
# this file by hand instead inherits these values as-is, which is very
# likely wrong for a different checkout or operator.
WorkingDirectory=/home/felix-hummert/srv/songmaker
ExecStart=/home/felix-hummert/srv/songmaker/scripts/send_alert.sh "Songmaker: %i failed" "systemd unit %i entered the failed state on %H. journalctl -u %i -n 50 --no-pager for detail."
User=felix-hummert
# No TimeoutStartSec override: Type=oneshot sets no start timeout, so the
# send bounds itself (curl --max-time in send_alert.sh) instead of relying on
# systemd to end a hung SMTP connection.
